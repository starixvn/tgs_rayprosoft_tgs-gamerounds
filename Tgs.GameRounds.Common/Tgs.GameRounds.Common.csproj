<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.1</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameRounds Common</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamerounds</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamerounds.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Protos\gamerounds.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.50.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="Protos\gamerounds.proto" GrpcServices="Client" />
	</ItemGroup>

</Project>
